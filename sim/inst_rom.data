// MIPS ori 指令测试程序 (hex, 每行 32 位指令字)
// op=001101 | rs | rt | imm16
34011100  // ori $1, $0, 0x1100  : $1 = 0x00001100 (基本写回)
342100FF  // ori $1, $1, 0x00FF  : $1 = 0x000011FF (读、写同一寄存器)
3402ABCD  // ori $2, $0, 0xABCD  : $2 = 0x0000ABCD (装载立即数)
34431234  // ori $3, $2, 0x1234  : $3 = 0x0000BBFD (rs 与 imm 按位或)
3400FFFF  // ori $0, $0, 0xFFFF  : $0 必须仍为 0      (写 $0 被忽略)
3404FFFF  // ori $4, $0, 0xFFFF  : $4 = 0x0000FFFF    (验证零扩展, 不是 0xFFFFFFFF)
